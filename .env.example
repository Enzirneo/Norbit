# Norbit — variáveis de ambiente
# Copie para .env e ajuste. O .env nunca é versionado.

# ─── Banco ───────────────────────────────────────────────────────────────────
POSTGRES_USER=norbit
POSTGRES_PASSWORD=norbit_dev
POSTGRES_DB=norbit
POSTGRES_PORT=5432

DATABASE_URL="postgresql://norbit:norbit_dev@localhost:5432/norbit?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ─── Ferramentas locais ──────────────────────────────────────────────────────
ADMINER_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN="http://localhost:4200"

# ─── Autenticação ────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET="troque-isto"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"

# ─── E-mail ──────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Norbit <nao-responda@norbit.app>"
