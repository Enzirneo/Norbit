{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    // A raiz do workspace, e não `src`: a partir do momento em que a api
    // importa uma lib (`@norbit/db`), os arquivos dela ficam fora de
    // `apps/api` e o TypeScript recusa com TS6059. Quem emite o bundle é o
    // webpack, então o layout de `outDir` aqui não tem efeito prático.
    "rootDir": "../../",
    "module": "commonjs",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
