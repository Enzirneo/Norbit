{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "types": ["jest", "node"],
    // O ts-jest precisa disto para transpilar os .js ESM de @nestjs/config.
    "allowJs": true
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "jest.setup.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
