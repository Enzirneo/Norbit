# O npm 10.9.2 falha ao resolver a arvore de peer deps do Angular/Nx neste
# projeto, com "Cannot read properties of null (reading 'edgesOut')" — um bug do
# arborist, nao um conflito real. Sem esta opcao o install nao conclui, nem aqui
# nem no CI. Ver docs/02-arquitetura.md.
legacy-peer-deps=true
